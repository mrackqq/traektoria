{
  "name": "traektoria",
  "version": "0.1.0",
  "private": true,
  "description": "ТРАЕКТОРИЯ — персональный маршрут поступления. Мост к мечте и стресс-тест маршрута.",
  "scripts": {
    "dev": "node scripts/next-run.mjs dev",
    "build": "node scripts/next-run.mjs build",
    "start": "node scripts/next-run.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts-resolve.mjs --test --experimental-strip-types --experimental-test-module-mocks \"src/**/*.test.ts\"",
    "test:coverage": "node --import ./scripts/register-ts-resolve.mjs --test --experimental-strip-types --experimental-test-module-mocks --experimental-test-coverage --test-coverage-lines=92 --test-coverage-branches=82 --test-coverage-functions=92 \"src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run test:coverage",
    "test:e2e": "playwright test",
    "shots": "playwright test --config playwright.shots.config.ts"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
